<?xml version="1.0" encoding="utf-8"?>
<!--
  OmniGFX marka ikonu — "kalibrasyon tezgâhı" kimliği.
  Motif: config atama operatörü (=) + alt barda kaydırıcı topuzu.
  Uygulamanın gerçek malzemesi olan key=value satırından türetildi.
  Üst bar petrol (doğrulandı), alt bar sönük petrol (ölçek rayı), topuz pirinç (sinyal).
  108x108 adaptive icon; güvenli bölge 21..87 içinde kalır.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Üst bar: doğrulanmış değer -->
    <path
        android:fillColor="#6ECDBD"
        android:pathData="M34.5,38 L73.5,38 A4.5,4.5 0 0 1 78,42.5 L78,42.5 A4.5,4.5 0 0 1 73.5,47 L34.5,47 A4.5,4.5 0 0 1 30,42.5 L30,42.5 A4.5,4.5 0 0 1 34.5,38 Z" />

    <!-- Alt bar: ölçek rayı -->
    <path
        android:fillColor="#2F6E64"
        android:pathData="M34.5,61 L73.5,61 A4.5,4.5 0 0 1 78,65.5 L78,65.5 A4.5,4.5 0 0 1 73.5,70 L34.5,70 A4.5,4.5 0 0 1 30,65.5 L30,65.5 A4.5,4.5 0 0 1 34.5,61 Z" />

    <!-- Ray üzerindeki tikler -->
    <path
        android:fillColor="#121A1B"
        android:fillAlpha="0.55"
        android:pathData="M38,63.5 h1.6 v4 h-1.6 Z M46,63.5 h1.6 v4 h-1.6 Z M54,63.5 h1.6 v4 h-1.6 Z" />

    <!-- Kaydırıcı topuzu: pirinç sinyal -->
    <path
        android:fillColor="#E3A94F"
        android:pathData="M67,57 A8.5,8.5 0 0 1 75.5,65.5 A8.5,8.5 0 0 1 67,74 A8.5,8.5 0 0 1 58.5,65.5 A8.5,8.5 0 0 1 67,57 Z" />

    <!-- Topuzun gövdeyle ayrışması için ince grafit halka -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#121A1B"
        android:strokeWidth="2"
        android:pathData="M67,57 A8.5,8.5 0 0 1 75.5,65.5 A8.5,8.5 0 0 1 67,74 A8.5,8.5 0 0 1 58.5,65.5 A8.5,8.5 0 0 1 67,57 Z" />
