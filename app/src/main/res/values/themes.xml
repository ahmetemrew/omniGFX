<resources>
    <!--
      Pencere teması. Uygulama tamamen Compose; renk/şekil/tipografi tek kaynaktan
      (core-ui/theme) gelir. Burada yalnızca Compose çizilmeden önceki pencere
      görünümü ve açılış ekranı tanımlanır.

      DayNight: açık/koyu tema sistem ayarını izler. Eski sabit Material3.Dark
      açık temada bile neon mor pencere gösteriyordu.
      Legacy View widget stilleri (Card/Toolbar/Button) kaldırıldı — kullanılmıyor.
    -->
    <style name="Theme.OmniGFX.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_petrol</item>
        <item name="colorSecondary">@color/brand_brass</item>
        <item name="android:windowBackground">@drawable/bg_app_shell</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.OmniGFX" parent="Theme.OmniGFX.Base" />
</resources>
