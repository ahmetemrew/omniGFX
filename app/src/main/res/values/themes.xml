<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OmniGFX.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@drawable/bg_app_shell</item>
        <item name="materialCardViewStyle">@style/Widget.OmniGFX.Card</item>
        <item name="toolbarStyle">@style/Widget.OmniGFX.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.OmniGFX.Button</item>
    </style>

    <style name="Theme.OmniGFX" parent="Theme.OmniGFX.Base" />

    <style name="Widget.OmniGFX.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/premium_card</item>
        <item name="strokeColor">@color/premium_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">24dp</item>
    </style>

    <style name="Widget.OmniGFX.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <style name="Widget.OmniGFX.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Cornered" parent="">
        <item name="cornerSize">20dp</item>
        <item name="cornerFamily">rounded</item>
    </style>
</resources>
